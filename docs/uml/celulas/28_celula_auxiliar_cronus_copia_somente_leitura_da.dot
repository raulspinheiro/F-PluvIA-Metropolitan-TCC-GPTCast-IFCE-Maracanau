digraph "auxiliar_cronus_copia_somente_leitura_da" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.6, labelloc=t, fontsize=14];
  node  [fontname="Helvetica", fontsize=10, shape=plain];
  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula auxiliar (Cronus) — Cópia somente-leitura das janelas observadas de 2026 da V1 (sem as previsões)</B> — 28 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula auxiliar (Cronus) — Cópia somente-leitura das janelas observadas de 2026 da V1 (sem as previsões)</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ DESTINO</TD></TR><TR><TD ALIGN="LEFT">+ ORIGEM</TD></TR><TR><TD ALIGN="LEFT">+ alvo</TD></TR><TR><TD ALIGN="LEFT">+ arquivos</TD></TR><TR><TD ALIGN="LEFT">+ copiados</TD></TR><TR><TD ALIGN="LEFT">+ pulados</TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#888888">—</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>glob<BR/>os<BR/>shutil>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
  entradas [shape=note, style=filled, fillcolor="#FCE4EC", fontsize=9, label=<<B>usa de outras células</B><BR/>SERIES_CACHE_DIR>];
  entradas -> celula [style=dashed, arrowhead=open, label="«use»"];
  arquivos [shape=folder, style=filled, fillcolor="#EDE7F6", fontsize=9, label=<<B>arquivos citados</B><BR/>RMF_2026_*_s2.npz<BR/>caso_*_s1.npz>];
  celula -> arquivos [style=dotted, arrowhead=open, label="lê/grava"];
}
