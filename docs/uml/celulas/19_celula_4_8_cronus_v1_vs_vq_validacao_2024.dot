  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>contextlib<BR/>einops<BR/>geopandas<BR/>gptcast<BR/>io<BR/>json<BR/>math<BR/>matplotlib<BR/>numpy<BR/>os<BR/>pandas<BR/>torch<BR/>urllib<BR/>warnings>];
  celula -> libs [style=dashed, arrowhead=open, label="«import»"];
