digraph "1" {
  graph [fontname="Helvetica", rankdir=LR, nodesep=0.35, ranksep=0.6, labelloc=t, fontsize=14];
  node  [fontname="Helvetica", fontsize=10, shape=plain];
  edge  [fontname="Helvetica", fontsize=8, color="#555555"];
  label=<<B>Célula 1</B> — 182 linhas>;
  celula [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF8E1"><TR><TD><FONT POINT-SIZE="9">«célula»</FONT><BR/><B>Célula 1</B></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">+ AMBIENTE_EXECUCAO</TD></TR><TR><TD ALIGN="LEFT">+ BASE_WORK_DIR</TD></TR><TR><TD ALIGN="LEFT">+ CHECKPOINTS_DIR</TD></TR><TR><TD ALIGN="LEFT">+ CHECKPOINTS_ENV_DIR</TD></TR><TR><TD ALIGN="LEFT">+ CRONUS_TEMPO_MAX_MIN</TD></TR><TR><TD ALIGN="LEFT">+ ENV_LABEL</TD></TR><TR><TD ALIGN="LEFT">+ ENV_TAG</TD></TR><TR><TD ALIGN="LEFT">+ ENV_TAG_V1</TD></TR><TR><TD ALIGN="LEFT">+ GPM_RAW_TEMP_DIR</TD></TR><TR><TD ALIGN="LEFT">+ OLD_SERIES_DIR</TD></TR><TR><TD ALIGN="LEFT">+ PASTA_V1_PROTEGIDA</TD></TR><TR><TD ALIGN="LEFT">+ RESULTS_ENV_DIR</TD></TR><TR><TD ALIGN="LEFT">+ SERIES_CACHE_DIR</TD></TR><TR><TD ALIGN="LEFT">+ SUFIXO_CRONUS</TD></TR><TR><TD ALIGN="LEFT"><I>+ 5 mais</I></TD></TR></TABLE></TD></TR><HR/><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT COLOR="#888888">—</FONT></TD></TR></TABLE></TD></TR></TABLE>>];
  libs [shape=tab, style=filled, fillcolor="#F1F8E9", fontsize=9, label=<<B>bibliotecas</B><BR/>cartopy<BR/>functools<BR/>geopandas<BR/>glob<BR/>google<BR/>gpm<BR/>lightning<BR/>os<BR/>pysteps<BR/>shutil<BR/>subprocess<BR/>sys<BR/>torch>];
